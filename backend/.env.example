# Local MongoDB instance started with `docker compose up -d mongo`
MONGO_URL=mongodb://localhost:27017
DB_NAME=bless_to_art

# Choose a unique secret before sharing or deploying this application.
ADMIN_PASSWORD=change-this-local-password

# Comma-separated browser origins permitted to call the API. Add deployed frontend
# domains here later; port 4200 is included for local development.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:4200,http://127.0.0.1:4200

# Product images are stored locally in backend/uploads/ during development.
# Use a managed object store before deploying the backend to production.
